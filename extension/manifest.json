{
  "manifest_version": 3,
  "name": "SEO Bandwagon",
  "version": "1.7.3",
  "version_name": "1.7.3 — a Rate us link, and full-page proof that never hangs",
  "description": "Check the on-page SEO of any page in one click: a score and the issues it finds, link and indexability checks, and more.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms",
    "webRequest",
    "webNavigation",
    "declarativeNetRequestWithHostAccess"
  ],
  "options_page": "src/options/options.html",
  "host_permissions": [
    "https://seobandwagon.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": ["https://seobandwagon.com/*"]
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://search.google.com/search-console/*"
      ],
      "js": [
        "src/lib/gsc-inject.js",
        "src/lib/gsc-compare.js",
        "src/content/gsc-serp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.ca/search*",
        "https://www.google.com.au/search*",
        "https://www.google.de/search*",
        "https://www.google.fr/search*",
        "https://www.google.es/search*",
        "https://www.google.it/search*",
        "https://www.google.nl/search*",
        "https://www.google.in/search*"
      ],
      "js": [
        "src/lib/serp.js",
        "src/overlay/serp-overlay.js"
      ],
      "css": [
        "src/overlay/serp-overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "analyze-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Analyze current page"
    }
  }
}

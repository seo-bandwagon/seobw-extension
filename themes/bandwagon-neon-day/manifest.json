{
  "manifest_version": 3,
  "name": "SEO Bandwagon — Neon Day",
  "version": "1.0.0",
  "description": "Off-white Chrome with a hazy neon city horizon and Bandwagon Pink accents. Pairs with the SEO Bandwagon extension.",
  "icons": { "128": "images/icon-128.png" },
  "theme": {
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_frame_inactive": "images/theme_frame_inactive.png",
      "theme_ntp_background": "images/ntp_background.png"
    },
    "colors": {
      "frame": [237, 237, 236],
      "frame_inactive": [228, 228, 227],
      "toolbar": [245, 245, 245],
      "tab_text": [0, 0, 34],
      "tab_background_text": [98, 98, 120],
      "bookmark_text": [0, 0, 34],
      "toolbar_button_icon": [194, 24, 91],
      "button_background": [0, 0, 34, 0.05],
      "omnibox_background": [255, 255, 255],
      "omnibox_text": [0, 0, 34],
      "ntp_background": [245, 245, 245],
      "ntp_text": [0, 0, 34],
      "ntp_link": [194, 24, 91]
    },
    "properties": {
      "ntp_background_alignment": "bottom",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 0
    }
  }
}

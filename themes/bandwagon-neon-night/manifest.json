{
  "manifest_version": 3,
  "name": "SEO Bandwagon — Neon Night",
  "version": "1.0.0",
  "description": "Midnight-navy Chrome with a neon city horizon and Bandwagon Pink accents. Pairs with the SEO Bandwagon extension.",
  "icons": { "128": "images/icon-128.png" },
  "theme": {
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_frame_inactive": "images/theme_frame_inactive.png",
      "theme_ntp_background": "images/ntp_background.png"
    },
    "colors": {
      "frame": [0, 0, 20],
      "frame_inactive": [0, 0, 12],
      "toolbar": [0, 0, 34],
      "tab_text": [245, 245, 245],
      "tab_background_text": [172, 172, 183],
      "bookmark_text": [245, 245, 245],
      "toolbar_button_icon": [245, 55, 150],
      "button_background": [245, 245, 245, 0.06],
      "omnibox_background": [10, 10, 46],
      "omnibox_text": [245, 245, 245],
      "ntp_background": [0, 0, 34],
      "ntp_text": [245, 245, 245],
      "ntp_link": [245, 55, 150]
    },
    "properties": {
      "ntp_background_alignment": "bottom",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 1
    }
  }
}

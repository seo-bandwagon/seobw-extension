{
  "manifest_version": 3,
  "name": "SEO Bandwagon",
  "version": "1.2.0",
  "description": "Instant SEO analysis: scores, meta tags, headings, schema, links, and tech stack detection.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "https://seobandwagon.com/api/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [],
  "commands": {
    "analyze-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Analyze current page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "history.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
{
  "manifest_version": 3,
  "name": "SEO Bandwagon",
  "version": "1.5.2",
  "version_name": "1.5.2 — Search Console row actions + compare math",
  "description": "Instant SEO analysis with A–F grades, plus local-SEO citation checks and link-building review, synced to your SEO Bandwagon account.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms",
    "webRequest",
    "webNavigation"
  ],
  "options_page": "src/options/options.html",
  "host_permissions": [
    "https://seobandwagon.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": ["https://seobandwagon.com/*"]
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://search.google.com/search-console/*"
      ],
      "js": [
        "src/lib/gsc-inject.js",
        "src/lib/gsc-compare.js",
        "src/content/gsc-serp.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "analyze-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Analyze current page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/history/history.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
